name: MSBuild with Release

on:
  push:
    branches: ["main"]
    paths:
      - "src/**"
      - "*.h*"
      - "**/*.sln"
      - "**/*.vcxproj"
      - "tests/**"
      - ".github/workflows/msbuild.yml"
  release:
    types: [created]

env:
  SOLUTION_FILE_PATH: ./src/Rand++.sln
  BUILD_CONFIGURATION: Release
  BUILD_PLATFORM: x64
  ARTIFACTS_DIR: artifacts

permissions:
  contents: write

jobs:
  build-and-release:
    runs-on: windows-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Add MSBuild to PATH
        uses: microsoft/setup-msbuild@v3

      - name: Setup NuGet
        uses: nuget/setup-nuget@v2

      - name: Restore NuGet packages
        run: nuget restore ${{ env.SOLUTION_FILE_PATH }}

      - name: Build solution
        run: msbuild /m /p:Configuration=${{ env.BUILD_CONFIGURATION }} /p:Platform=${{ env.BUILD_PLATFORM }} ${{ env.SOLUTION_FILE_PATH }}

      - name: Run C++ unit tests
        run: |
          $testExe = ".\src\${{ env.BUILD_PLATFORM }}\${{ env.BUILD_CONFIGURATION }}\cpp_tests.exe"
          if (-not (Test-Path $testExe)) {
            Write-Host "cpp_tests.exe не найден в $testExe — ищем рекурсивно..."
            $found = Get-ChildItem -Path ".\src" -Filter "cpp_tests.exe" -Recurse | Select-Object -First 1
            if ($found) {
              $testExe = $found.FullName
              Write-Host "Найден: $testExe"
            } else {
              Write-Error "cpp_tests.exe не найден!"
              exit 1
            }
          }
          Write-Host "Running: $testExe"
          & $testExe
          if ($LASTEXITCODE -ne 0) {
            Write-Error "C++ unit tests FAILED (exit code: $LASTEXITCODE)"
            exit 1
          }
          Write-Host "C++ unit tests PASSED"

      - name: Generate test data (CLI mode) CPP
        run: |
          $outputFileCpp = Join-Path $PWD "test_datacpp.bin"
          $genExe = Get-ChildItem -Path ".\src" -Filter "Rand++.exe" -Recurse | Select-Object -First 1 | ForEach-Object { $_.FullName }
          if (-not $genExe) { Write-Error "Rand++.exe не найден!"; exit 1 }
          & $genExe -a 0 -b 256 -n 2000000 -p 73.8 -f bin -s 8 -e cpp -o $outputFileCpp

      - name: Generate test data (CLI mode) C
        run: |
          $outputFileC = Join-Path $PWD "test_datac.bin"
          $genExe = Get-ChildItem -Path ".\src" -Filter "Rand++.exe" -Recurse | Select-Object -First 1 | ForEach-Object { $_.FullName }
          if (-not $genExe) { Write-Error "Rand++.exe не найден!"; exit 1 }
          & $genExe -a 0 -b 256 -n 2000000 -p 73.8 -f bin -s 8 -e c -o $outputFileC

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Python dependencies
        run: pip install sp80022suite numpy scipy

      - name: Run NIST CPP statistical tests
        run: python tests/run_nist_tests.py test_datacpp.bin

      - name: Run NIST C statistical tests
        run: python tests/run_nist_tests.py test_datac.bin

      - name: Create artifacts directory
        run: New-Item -ItemType Directory -Force -Path ${{ env.ARTIFACTS_DIR }}

      - name: Copy additional files from repository
        run: |
          Copy-Item -Path "README.md" -Destination "${{ env.ARTIFACTS_DIR }}" -Force
          Copy-Item -Path "LICENSE" -Destination "${{ env.ARTIFACTS_DIR }}" -Force
          Copy-Item -Path "ГПСЧ" -Destination "${{ env.ARTIFACTS_DIR }}" -Force
          Copy-Item -Path "ГПСЧ-КРИПТО" -Destination "${{ env.ARTIFACTS_DIR }}" -Force
          if (Test-Path "PERFECT_RANDOM_LOGO.JPEG") {
            Copy-Item -Path "PERFECT_RANDOM_LOGO.JPEG" -Destination "${{ env.ARTIFACTS_DIR }}" -Force
          } else {
            Write-Warning "PERFECT_RANDOM_LOGO.JPEG не найден — пропускаем"
          }

      - name: Compress build output
        run: |
          $zipPath = "${{ env.ARTIFACTS_DIR }}\perfect-random.zip"
          $expectedPath = ".\src\${{ env.BUILD_PLATFORM }}\${{ env.BUILD_CONFIGURATION }}"
          $exeFiles = Get-ChildItem -Path $expectedPath -Filter "*.exe" -Recurse -File
          if ($exeFiles.Count -eq 0) {
            $exeFiles = Get-ChildItem -Path ".\src" -Filter "*.exe" -Recurse -File
          }
          if ($exeFiles.Count -eq 0) {
            Write-Error "Ни одного .exe не найдено!"
            exit 1
          }
          foreach ($f in $exeFiles) {
            Copy-Item -Path $f.FullName -Destination "${{ env.ARTIFACTS_DIR }}" -Force
          }
          Compress-Archive -Path "${{ env.ARTIFACTS_DIR }}\*" -DestinationPath $zipPath -Force
          Write-Host "Архив создан: $zipPath"
          [System.IO.Compression.ZipFile]::OpenRead($zipPath).Entries | ForEach-Object { Write-Host "  $($_.FullName)" }

      # ── ТОЛЬКО при событии release: создать релиз и загрузить ассеты ──
      - name: Calculate short commit hash
        id: short-sha
        if: github.event_name == 'release'
        run: |
          $sha = "${{ github.sha }}"
          $short = $sha.Substring(0, 7)
          "SHORT_SHA=$short" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding ASCII

      - name: Create Release and Upload Asset
        uses: softprops/action-gh-release@v2
        if: github.event_name == 'release'
        with:
          tag_name: ${{ github.event.release.tag_name }}
          name: Release ${{ github.event.release.tag_name }}
          body: |
            Сборка проекта Rand++ / perfect_random

            **Версия:** ${{ github.event.release.tag_name }}
            **Коммит:** `${{ steps.short-sha.outputs.SHORT_SHA }}`
            **Полный SHA:** ${{ github.sha }}

            В архиве вы можете найти hpp, h  версии библиотеки, криптостойкую версию, а так же
            README.md, лицензию и logo.
            Подпись sha256 выполняется после прохождения тестов BigCrush, PractRand.
          files: |
            ${{ env.ARTIFACTS_DIR }}/perfect-random.zip
          draft: false
          prerelease: false
          fail_on_unmatched_files: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Cleanup
        if: always()
        run: |
          if (Test-Path ${{ env.ARTIFACTS_DIR }}) {
            Remove-Item -Path ${{ env.ARTIFACTS_DIR }} -Recurse -Force
          }
          foreach ($file in @("test_datacpp.bin","test_datac.bin")) {
            if (Test-Path $file) { Remove-Item -Path $file -Force }
          }
